{
  "name": "skirin",
  "version": "1.0.0",
  "description": "Skirin — a beautiful, native-feeling screenshot studio for Windows",
  "main": "./out/main/index.js",
  "author": "Skirin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/make-icons.mjs && electron-vite dev",
    "start": "electron-vite preview",
    "build": "node scripts/make-icons.mjs && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/make-icons.mjs && electron-vite build && electron-builder --win --publish never",
    "dist:portable": "node scripts/make-icons.mjs && electron-vite build && electron-builder --win portable --publish never",
    "dist:zip": "node scripts/make-icons.mjs && electron-vite build && electron-builder --win zip --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rednaxelalike/Skirin.git"
  },
  "homepage": "https://github.com/Rednaxelalike/Skirin",
  "bugs": {
    "url": "https://github.com/Rednaxelalike/Skirin/issues"
  }
}
