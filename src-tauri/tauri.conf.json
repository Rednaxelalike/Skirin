{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skirin",
  "version": "2.1.0",
  "identifier": "com.skirin.app",
  "build": {
    "frontendDist": "../src/renderer/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://skirin.localhost; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; connect-src 'self' ipc: http://ipc.localhost http://skirin.localhost data: blob: https://cdn.jsdelivr.net https://unpkg.com https://tessdata.projectnaptha.com; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "Skirin",
    "category": "Utility",
    "shortDescription": "Screenshot studio for Windows",
    "longDescription": "Skirin — a beautiful, native-feeling screenshot studio for Windows.",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMjZDOThFRUUwRUVFN0QKUldSOTdnN3Vqc2ttME9ZUGhJZUxyZUp4dTlkd1lNRWRXckZZL1U4RCtiNE9SQUpPYUp6elNZSzkK",
      "endpoints": [
        "https://github.com/Rednaxelalike/Skirin/releases/latest/download/latest.json"
      ]
    }
  }
}
